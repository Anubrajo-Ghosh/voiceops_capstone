# Copy this file, rename the copy to ".env", and paste your keys. NEVER commit ".env".
GNANI_API_KEY=

# ---- LLM: choose ONE block -------------------------------------------------------------
# A) Gemini (Google AI Studio key) - uncomment these 5 lines:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_gemini_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-flash-latest
# LLM_MAX_TOKENS=1500
# (if the model name is rejected, 1_setup_check.py finds a working one and tells you what to paste)

# B) Claude - uncomment and fill:
# ANTHROPIC_API_KEY=your_anthropic_key_here
# LLM_MODEL=claude-sonnet-5-5

# C) No LLM at all (offline rule-based fallback, for testing only):
# LLM_PROVIDER=none

# Where the unzipped dataset is (relative to this folder is fine):
ZENTRO_DATASET_DIR=Capstone_Project_Dataset_FTTT_2026

# ---- optional tuning ----
GNANI_STT_MODEL=prisma-v3.0     # prisma-v3.0 | prisma-v2.5
GNANI_STT_LANGUAGE=indic-auto   # if Hindi/Hinglish transcribes badly try: en-IN,hi-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_VOICE_EN=Kaveri
GNANI_VOICE_HI=Nalini
GNANI_VOICE_HINGLISH=Poorvi
USE_DENSE=0
